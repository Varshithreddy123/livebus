{
  "expo": {
    "name": "Chakraa",
    "slug": "Chakraa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "Chakraa",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.livebustracking.Chakraa",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB2FZr208vxtUuEH4NLT87LnnDDDtRsemo"
        }
      },
      "plugins": [
        [
          "expo-build-properties",
          {
            "android": {
              "kotlinVersion": "1.9.23"
            }
          }
        ]
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/TT-Octosquares-Medium.ttf"
          ]
        }
      ],
      "expo-maps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "37420135-6aae-43ad-bd9f-814a68519e7e"
      }
    }
  }
}
