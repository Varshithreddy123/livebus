generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model BusStand {
  id String @id @default(auto()) @map("_id") @db.ObjectId
}

model Route {
  id String @id @default(auto()) @map("_id") @db.ObjectId
}

model RouteStop {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  busStandId String? @db.ObjectId
  routeId    String? @db.ObjectId


  @@unique([routeId, busStandId])
}

model driver {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId

  name                String
  country             String
  phone_number        String?   @unique
  email               String

  vehicle_type        String?
  vehicle_color       String?
  vehicleNumber       String?
  vehicleImage        String?

  registration_number String?   @unique
  registration_date   String?

  driving_license     String?
  rate                String?
  rating              Float?    @default(0)
  ratings             Float?    @default(0)

  totalEarning        Float     @default(0)
  totalRides          Float     @default(0)
  pendingRides        Float     @default(0)
  cancelRides         Float     @default(0)
  status              String    @default("inactive")

  latitude            Float?
  longitude           Float?

  // Back-relations
  rides               rides[] @relation("DriverRides")

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}



model rides {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String?  @db.ObjectId
  driverId                String?  @db.ObjectId
  charge                  Float?
  status                  String?
  currentLocationName     String?
  destinationLocationName String?
  distance                Float?

  // Relations
  user   user?   @relation("UserRides", fields: [userId], references: [id])
  driver driver? @relation("DriverRides", fields: [driverId], references: [id])

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model user {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String?
  email        String?
  cratedAt     DateTime? @db.Date
  createdAt    DateTime? @db.Date
  phoneNumber  String?
  phone_number String?   @unique
  ratings      Float?
  totalRides   Float
  updatedAt    DateTime  @db.Date

  // Back-relations
  rides        rides[] @relation("UserRides")
}
